source=(
  "jdk21u-${pkgver}-${_pkgrel}.tar.gz::https://github.com/adoptium/jdk21u/archive/refs/tags/jdk-${pkgver}%2B${_pkgrel}_adopt.tar.gz"
  "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${_bootver}%2B${_bootrel}/OpenJDK21U-jdk_x64_linux_hotspot_${_bootver}_${_bootrel}.tar.gz"
  "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${_bootver}%2B${_bootrel}/OpenJDK21U-jdk_aarch64_linux_hotspot_${_bootver}_${_bootrel}.tar.gz"
)
# Boot JDKs unpack to the same directory name; build() extracts the one
# matching the build host.
noextract=(
  "OpenJDK21U-jdk_x64_linux_hotspot_${_bootver}_${_bootrel}.tar.gz"
  "OpenJDK21U-jdk_aarch64_linux_hotspot_${_bootver}_${_bootrel}.tar.gz"
)
sha256sums=(
  '5f7e6a647d91bb46662eeffd1bd13a3acda4dc8af4eb298752ae99e03e9eb918'
  'd7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c'
  'e3522e707fc7dbe2a72c30746b1e7068301a0213ecd213d4491f35a14eb55578'
)

build() {
  cd "${srcdir}"

  case "$(uname -m)" in
    x86_64) _bootarch="x64" ;;
    aarch64) _bootarch="aarch64" ;;
    *)
      echo "unsupported build host $(uname -m)" >&2
      return 1
      ;;
  esac
  rm -rf bootjdk
  mkdir bootjdk
  tar -xzf "OpenJDK21U-jdk_${_bootarch}_linux_hotspot_${_bootver}_${_bootrel}.tar.gz" \
    -C bootjdk --strip-components=1

  # OpenJDK configure rejects/overrides toolchain flags from the environment;
  # extra flags must go through --with-extra-*.
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

  # configure sizes the job count from host cores/RAM, not the container's
  # cgroup limits: derive it from the CPU quota to avoid OOM kills.
  _jobs=$(nproc)
  if [ -r /sys/fs/cgroup/cpu.max ]; then
    read -r _quota _period </sys/fs/cgroup/cpu.max
    if [ "${_quota}" != "max" ]; then
      _jobs=$(((_quota + _period - 1) / _period))
    fi
  fi

  _cross_args=()
  if [ -n "${CROSS_COMPILE}" ]; then
    # Debian multiarch: target headers in /usr/include, libs in
    # /usr/lib/<triplet>. configure builds a native build-JDK on its own.
    _cross_args=(
      "--openjdk-target=${CROSS_COMPILE_HOST}"
      "--x-includes=/usr/include"
      "--x-libraries=/usr/lib/${CROSS_COMPILE_HOST}"
      "--with-alsa-include=/usr/include"
      "--with-alsa-lib=/usr/lib/${CROSS_COMPILE_HOST}"
      "--with-cups-include=/usr/include"
      "--with-fontconfig-include=/usr/include"
    )
    unset CC CXX CPP LD AR NM OBJCOPY STRIP
  fi

  cd "${srcdir}/jdk21u-jdk-${pkgver}-${_pkgrel}_adopt"
  bash configure \
    --with-conf-name=release \
    --with-boot-jdk="${srcdir}/bootjdk" \
    --with-jobs="${_jobs}" \
    --with-version-pre= \
    --with-version-opt=LTS \
    --with-version-build="${_pkgrel}" \
    --with-vendor-name="Zextras" \
    --with-vendor-url="https://zextras.com/" \
    --with-vendor-bug-url="https://github.com/zextras/carbonio-thirds-openjdk/issues" \
    --with-vendor-vm-bug-url="https://github.com/zextras/carbonio-thirds-openjdk/issues" \
    --with-native-debug-symbols=external \
    --with-freetype=bundled \
    --with-zlib=bundled \
    --with-libjpeg=bundled \
    --with-giflib=bundled \
    --with-libpng=bundled \
    --with-lcms=bundled \
    --with-harfbuzz=bundled \
    --enable-dtrace \
    --disable-precompiled-headers \
    --disable-warnings-as-errors \
    --disable-ccache \
    "${_cross_args[@]}"

  make CONF=release images
}

package() {
  mkdir -p "${pkgdir}"/opt/zextras/common/bin
  mkdir -p "${pkgdir}"/opt/zextras/common/lib/jvm
  cp -a "${srcdir}/jdk21u-jdk-${pkgver}-${_pkgrel}_adopt/build/release/images/jdk" \
    "${pkgdir}"/opt/zextras/common/lib/jvm/java
  cd "${pkgdir}"/opt/zextras/common/lib/jvm/java
  mv include/linux/* include
  rm -rf include/linux
  rm -rf lib/src.zip
  rm -rf legal
  chmod 644 lib/ct.sym

  cd lib/security
  rm -f cacerts
  ln -s /opt/zextras/common/etc/java/cacerts cacerts

  cd "${pkgdir}"/opt/zextras/common/bin
  ln -s ../lib/jvm/java/bin/jar .
  ln -s ../lib/jvm/java/bin/java .
  ln -s ../lib/jvm/java/bin/javac .
  ln -s ../lib/jvm/java/bin/javap .
  ln -s ../lib/jvm/java/bin/jhat .
  ln -s ../lib/jvm/java/bin/jmap .
  ln -s ../lib/jvm/java/bin/jps .
  ln -s ../lib/jvm/java/bin/jstack .
  ln -s ../lib/jvm/java/bin/jstat .
  ln -s ../lib/jvm/java/bin/keytool .
}

# A cross-compiled JDK cannot run the target java at build time, so the
# default CDS archives (shipped by Temurin) are missing on aarch64: generate
# them on the target and track them with a marker so only those are removed.
_cds_generate() {
  _jvm=/opt/zextras/common/lib/jvm/java
  if [ ! -f "${_jvm}/lib/server/classes.jsa" ]; then
    "${_jvm}/bin/java" -Xshare:dump >/dev/null 2>&1 &&
      "${_jvm}/bin/java" -XX:-UseCompressedOops -Xshare:dump \
        -XX:SharedArchiveFile="${_jvm}/lib/server/classes_nocoops.jsa" >/dev/null 2>&1 &&
      touch "${_jvm}/lib/server/.cds-generated"
  fi
  return 0
}

_cds_remove() {
  _jvm=/opt/zextras/common/lib/jvm/java
  if [ -f "${_jvm}/lib/server/.cds-generated" ]; then
    rm -f "${_jvm}/lib/server/classes.jsa" \
      "${_jvm}/lib/server/classes_nocoops.jsa" \
      "${_jvm}/lib/server/.cds-generated"
  fi
  return 0
}

postinst() {
  _cds_generate
}

prerm() {
  _cds_remove
}
