pkgname="carbonio-openjdk"
pkgver="25.0.5" # renovate: datasource=github-releases depName=adoptium/temurin25-binaries
pkgrel="1"
_pkgrel=8
pkgdesc="OpenJDK Java 25 development kit"
arch=('aarch64' 'x86_64')
maintainer="Zextras <packages@zextras.com>"
url="https:/zextras.com"
section="utils"
priority="optional"
options=('!strip')
license=("GPL-2.0-with-classpath-exception")
source_aarch64=(
  "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${pkgver}%2B${_pkgrel}/OpenJDK25U-jdk_aarch64_linux_hotspot_${pkgver}_${_pkgrel}.tar.gz"
)
source_x86_64=(
  "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${pkgver}%2B${_pkgrel}/OpenJDK25U-jdk_x64_linux_hotspot_${pkgver}_${_pkgrel}.tar.gz"
)
sha256sums_aarch64=(
  'bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880'
)
sha256sums_x86_64=(
  '68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb'
)

package() {
  cd "${srcdir}"
  mkdir -p "${pkgdir}"/opt/zextras/common/bin
  mkdir -p "${pkgdir}"/opt/zextras/common/lib/jvm
  cp -r "jdk-${pkgver}"* "${pkgdir}"/opt/zextras/common/lib/jvm/java
  cd "${pkgdir}"/opt/zextras/common/lib/jvm/java
  mv include/linux/* include
  rm -rf include/linux
  rm -rf lib/src.zip
  rm -rf legal
  chmod 644 lib/ct.sym

  cd lib/security
  rm -f cacerts
  ln -s /opt/zextras/common/etc/java/cacerts cacerts

  cd "${pkgdir}"/opt/zextras/common/bin
  ln -s ../lib/jvm/java/bin/jar .
  ln -s ../lib/jvm/java/bin/java .
  ln -s ../lib/jvm/java/bin/javac .
  ln -s ../lib/jvm/java/bin/javap .
  ln -s ../lib/jvm/java/bin/jhat .
  ln -s ../lib/jvm/java/bin/jmap .
  ln -s ../lib/jvm/java/bin/jps .
  ln -s ../lib/jvm/java/bin/jstack .
  ln -s ../lib/jvm/java/bin/jstat .
  ln -s ../lib/jvm/java/bin/keytool .
}
