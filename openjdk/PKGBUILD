pkgname="carbonio-openjdk"
pkgver="21.0.13.1" # renovate: datasource=github-tags depName=adoptium/jdk21u
pkgrel="1"
_pkgrel=2
_bootver="21.0.13"
_bootrel=9
pkgdesc="OpenJDK Java 21 development kit"
arch=('aarch64' 'x86_64')
maintainer="Zextras <packages@zextras.com>"
url="https:/zextras.com"
section="utils"
priority="optional"
options=('!strip')
license=("GPL-2.0-with-classpath-exception")
# Built from the same Adoptium source tree and with the same configure
# choices (bundled freetype/zlib/libjpeg/giflib/libpng/lcms/harfbuzz, dtrace,
# external debug symbols, no PCH) Temurin uses, so the resulting image has
# the same content as the Temurin tarball we used to repackage.
makedepends__apt=(
